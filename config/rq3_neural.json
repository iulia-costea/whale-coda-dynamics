  "capacity_multiplier": 2,
  "bootstrap_draws": 1000,
  "bootstrap_seed": 42,
  "device": "auto",
  "workers": null,
  "pilot": {
    "own_clan": "EC2",
    "own_fold": 0,
    "pooled_run": 0,
    "pooled_alpha": 0.7,
    "pooled_tagged": true,
    "cpu_workers": [10, 18],
    "gpu_workers": [1, 4],
    "timing_epochs": 3,
    "tie_tolerance": 0.05,
    "budget_hours": 6,
    "stop_hours": 12,
    "cublas_workspace_config": ":4096:8"
