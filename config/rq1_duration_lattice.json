      "onset_vs_raw": {"max_abs": 0},
      "nclicks_vs_intervals": {"count": 2},
      "own_lags": {"counts": [1547, 1324, 1088]},
      "partner_lags": {"counts": [1547, 1324, 1084]},
      "targets_by_clicks": {"counts": {"3": 32, "4": 111, "5": 1222, "6": 52, "7": 22, "8": 21, "9": 19, "10": 9, "11": 2,
