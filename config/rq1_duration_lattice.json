  "output_directory": "data/results/rq1_duration_lattice",
  "report": "reports/rq1_duration_lattice.md",
  "require_clean_tree": true,
  "history_lags": 3,
  "count_one_hot_min_training_targets": 10,
  "always_present_penalty": 0.0001,
  "variants": {
    "F": {"target_type": false, "label": "type-free"},
    "T": {"target_type": true, "label": "the target's type given"}
  },
  "primary": {"variant": "F", "contrast": "partner"},
  "secondary": [
    {"variant": "F", "contrast": "own"},
    {"variant": "F", "contrast": "timing"},
    {"variant": "T", "contrast": "partner"}
  ],
  "alpha": 0.05,
  "calibration": {"variant": "F", "contrast": "partner", "fractions": [0.1, 0.2, 0.3], "sigma_condition": "A_S"},
  "checks": {
    "enforce": true,
    "tolerance": 0.0005,
    "source": "computed independently before the run (DEC-30 prompt, 2026-10-09)",
    "expected": {
